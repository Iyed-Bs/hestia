# =============================================================================
# Hestia gateway settings.  cp .env.example .env  and edit.
#
# Every setting is optional unless marked REQUIRED. Values here are read by
# the gateway (any HESTIA_* variable) and by compose.yaml.
# For a real installation, ./deploy/setup.sh fills in the secrets for you.
# Never commit .env: it is git-ignored and CI scans for leaked secrets.
# =============================================================================

# ── General ───────────────────────────────────────────────────────────────────
# development: missing secrets are generated into the data folder, cookies
#              work over plain http (for `uvicorn` on your machine).
# production:  the gateway refuses to start if a required secret is missing
#              or too short. Use it for anything other people can reach.
HESTIA_ENV=production

# twin:   the digital twin (a simulated installation on a real weather year).
#         Nothing physical can be driven. Use it for demos and evaluation.
# device: a real controller over MQTT (needs the broker: --profile device).
HESTIA_MODE=twin

# Shown in the dashboard and on safety reports.
HESTIA_SITE_NAME=Demo building, Tunis

# Two demo logins (visitor / hestia-visitor read-only, operator /
# hestia-operator). Only possible in twin mode: the gateway refuses them with
# a real device. Turn on for a public demo, off otherwise.
HESTIA_DEMO_USERS=false

HESTIA_LOG_LEVEL=INFO

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
#   (or: docker compose run --rm gateway python -m hestia.cli new-secret)

# REQUIRED in production. Signs session cookies. Changing it signs everyone out.
HESTIA_SECRET_KEY=

# REQUIRED in production. Signs every line of the safety journal (64+ hex).
# Keep a copy somewhere safe: without it, the journal can still be read but
# its signatures can no longer be verified.
HESTIA_JOURNAL_KEY=

# ── Web access ────────────────────────────────────────────────────────────────
# Name in the browser's address bar, and how its HTTPS certificate is obtained:
#   HESTIA_TLS=internal         local name (hestia.local, localhost): Caddy's own CA
#   HESTIA_TLS=you@example.com  public domain pointing here: Let's Encrypt
HESTIA_DOMAIN=localhost
HESTIA_TLS=internal

# Session length, and the login lock-out after repeated failures
# (counted per account and per address).
HESTIA_SESSION_HOURS=12
HESTIA_LOGIN_MAX_FAILURES=5
HESTIA_LOGIN_LOCKOUT_MINUTES=15

# ── Digital twin (HESTIA_MODE=twin) ───────────────────────────────────────────
# Simulated seconds per real second (60 = one hour per minute).
HESTIA_TWIN_SPEED=60

# ── Simulator (a private whole-site sandbox per signed-in session) ────────────
# Each one runs its own physics loop: cap them for a small gateway. A
# simulation nobody watches is closed after the idle time.
HESTIA_SIM_ENABLED=true
HESTIA_SIM_MAX_SESSIONS=8
HESTIA_SIM_IDLE_MINUTES=15

# ── Real installation (HESTIA_MODE=device) ────────────────────────────────────
# Must match firmware/include/config.h (SITE_ID, DEVICE_ID, TOPIC_PREFIX).
HESTIA_SITE_ID=site1
HESTIA_DEVICE_ID=esp32_1
HESTIA_TOPIC_PREFIX=hestia

# The gateway's own broker login (made by deploy/setup.sh). REQUIRED in device mode.
HESTIA_MQTT_PASSWORD=

# Shared with the controller (COMMAND_HMAC_KEY in firmware/include/secrets.h):
# every command is signed with it. 64 hex characters. REQUIRED in device mode.
HESTIA_DEVICE_COMMAND_KEY=

# How long a production permit lasts on the controller if the gateway stops
# refreshing it (it refreshes every third of this).
HESTIA_PERMIT_VALID_S=120

# Solar production on a site without inverter metering:
#   weather  estimated from live irradiance (Open-Meteo) × HESTIA_PV_KWP
#   bench    a fixed 1 kW, for a lab bench on mains power
HESTIA_PV_SOURCE=weather
HESTIA_SITE_LATITUDE=36.8
HESTIA_SITE_LONGITUDE=10.2
HESTIA_PV_KWP=1.8

# ── E-mail alerts (off until you turn them on) ────────────────────────────────
# An e-mail, in English and French, for an H₂ alarm, an untrusted sensor, an
# over-temperature or a controller that went silent. Everything is recorded in
# the safety journal either way; e-mail is how people hear about it at once.
#
# With Gmail (simplest):
#   1. Use a Gmail account for the building (a dedicated one is best).
#   2. Turn on 2-Step Verification for it: https://myaccount.google.com/security
#   3. Create an app password: https://myaccount.google.com/apppasswords
#      (name it "Hestia"). Google shows 16 letters in four groups; paste them
#      as shown, spaces or not. This is NOT the account's normal password, and
#      it can be revoked there at any time without touching the account.
#   4. Fill in the four lines below, restart the gateway, then check delivery
#      from the dashboard (Administration → E-mail alerts → Send a test e-mail)
#      or with:  docker compose exec gateway python -m hestia.cli test-email
# The password stays in this file: it is never typed into the dashboard nor
# stored in the database. If a setting is wrong while alerts are on, the
# gateway refuses to start and says which one.
HESTIA_EMAIL_ALERTS=false
HESTIA_GMAIL_ADDRESS=
HESTIA_GMAIL_APP_PASSWORD=
# Who receives the alerts, as a JSON list: ["owner@example.com","technician@example.com"]
HESTIA_ALERT_RECIPIENTS=[]
# At most one e-mail per kind of problem in this many minutes (the journal
# still records every occurrence).
HESTIA_ALERT_COOLDOWN_MINUTES=15

# Any other mail server instead of Gmail: set HESTIA_EMAIL_PROVIDER=smtp and
# fill these in (port 587 = STARTTLS, 465 = TLS from the start).
HESTIA_EMAIL_PROVIDER=gmail
HESTIA_SMTP_HOST=
HESTIA_SMTP_PORT=587
HESTIA_SMTP_STARTTLS=true
HESTIA_SMTP_USERNAME=
HESTIA_SMTP_PASSWORD=
HESTIA_SMTP_FROM=

# ── Trust layer ───────────────────────────────────────────────────────────────
# What the H₂ sensor reads in clean air after calibration (ppm).
HESTIA_H2_BASELINE_PPM=55
# Maintenance plan, in days. Start from these and follow the sensor
# manufacturer's manual and local regulations. Beyond the grace period, an
# overdue check makes the H₂ sensor untrusted and production stops.
HESTIA_BUMP_TEST_DAYS=30
HESTIA_CALIBRATION_DAYS=180
HESTIA_INSPECTION_DAYS=365
HESTIA_MAINTENANCE_GRACE_DAYS=14

# ── Planner ───────────────────────────────────────────────────────────────────
# true: fetch a year of weather for any location from Open-Meteo (cached).
# false: offline, the bundled Tunis year only.
HESTIA_PLANNER_INTERNET=true
